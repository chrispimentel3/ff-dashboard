# Copy to .env and fill in.

# ── Yahoo Fantasy API (official, via YFPY) ────────────────────────────────
# Create an app at https://developer.yahoo.com/apps/create/
#   Application Type : Installed Application
#   Redirect URI     : https://localhost:8080
#   API Permissions  : Fantasy Sports (Read)
# Then run:  uv run python pull_league.py   (first run does a one-time browser OAuth)
YAHOO_CONSUMER_KEY=
YAHOO_CONSUMER_SECRET=
# (pull_league.py caches the OAuth token back into this file after the first run)

# ── Emailed Tuesday digest (optional) ────────────────────────────────────
# Gmail: SMTP_PASS must be a 16-char App Password (Google account > Security >
# App passwords), not your normal password. Requires 2-Step Verification.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=
DIGEST_TO=you@gmail.com
